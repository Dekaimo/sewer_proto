{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/japanese_reply.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/japanese_reply.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/japanese_reply.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./assets_raw/archive/**)",
      "Glob(./assets_raw/archive/**)",
      "Grep(./assets_raw/archive/**)"
    ]
  }
}
